{
  "name": "local-agent-automation-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for SQLite-backed TODOs and scheduled coding-agent jobs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brili99/automation-mcp.git"
  },
  "homepage": "https://github.com/brili99/automation-mcp#readme",
  "bugs": {
    "url": "https://github.com/brili99/automation-mcp/issues"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "automation-mcp": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "deploy",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --watch src/cli/index.ts",
    "build": "bun run typecheck && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "test": "bun run typecheck && bun test",
    "prepack": "bun run check",
    "check": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "cron-parser": "^5.10.1",
    "gpt-tokenizer": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
